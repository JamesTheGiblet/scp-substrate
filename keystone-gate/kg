#!/usr/bin/env python3
"""kg — Keystone Gate CLI. Shares substrate DB with scps."""
import argparse
import sys
from pathlib import Path

# Two paths:
#   parent.parent → find `substrate`
#   parent        → find `kg_*` siblings
_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here.parent))
sys.path.insert(0, str(_here))


def cmd_stats(args):
    from kg_stats import stats
    st = stats()
    print("Keystone Gate content in substrate:")
    for k, v in st.items():
        print(f"  {k:12} {v}")


def cmd_route_list(args):
    from kg_router import route_list
    neighbours = route_list()
    if not neighbours:
        print("No neighbours yet (empty foundation:neighbour).")
        print("This is expected — boundary is proven, logic not yet built.")
    else:
        for n in neighbours:
            print(f"  {n}")


def main():
    ap = argparse.ArgumentParser(prog="kg", description="Keystone Gate CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("stats", help="count Keystone Gate capsules in substrate")
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("route", help="neighbourhood-router operations")
    sp_sub = sp.add_subparsers(dest="route_cmd", required=True)
    sp_list = sp_sub.add_parser("list", help="list all neighbours")
    sp_list.set_defaults(func=cmd_route_list)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
