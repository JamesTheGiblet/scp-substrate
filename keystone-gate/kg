#!/usr/bin/env python3
"""kg — Keystone Gate CLI. Shares substrate DB with scps."""
import argparse
import sys
from pathlib import Path

# Two paths:
#   parent.parent → find `substrate`
#   parent        → find `kg_*` siblings
_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here.parent))
sys.path.insert(0, str(_here))

from substrate import Substrate


def cmd_stats(args):
    from kg_stats import stats
    st = stats()
    print("Keystone Gate content in substrate:")
    for k, v in st.items():
        print(f"  {k:12} {v}")


def cmd_route_list(args):
    from kg_router import route_list
    rows = route_list()
    if not rows:
        print("No neighbours yet.")
        print("Cubes have no neighbour links.")
        return
    for r in rows:
        print(f"  {r['cube']}")
        for n in r["neighbours"]:
            print(f"    -> {n}")


def cmd_ask(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    question = " ".join(args.question)
    sc = load_sc(s)
    result = ask_gated(s, question, sc=sc)
    s.close()

    if result.get("no_intent"):
        print(f"No intent matched for: {question!r}")
        print("(nothing to gate, nothing to answer)")
        return

    if result.get("rejected"):
        print(f"Gate rejected the answer.")
        for v in result["check"]["violations"]:
            print(f"  - {v['rule']}: {v['detail']}")
        print()
        print("The answer is withheld. Compliance must pass before any answer is shown.")
        return

    print(result["answer"])


def cmd_gate_check(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    question = " ".join(args.question)
    sc = load_sc(s)
    if sc is None:
        print("No sc capsule loaded — cannot gate.")
        s.close()
        return
    print(f"Gate: {sc.get('name')}")
    print(f"Rules: {[m['rule'] for m in sc.get('must', [])]}")
    print()

    result = ask_gated(s, question, sc=sc)
    s.close()

    if result.get("no_intent"):
        print(f"Question: {question!r}")
        print("Result: no intent matched — nothing to check")
        return

    if result.get("rejected"):
        print(f"Question: {question!r}")
        print("Result: REJECTED")
        for v in result["check"]["violations"]:
            print(f"  violation [{v['rule']}]: {v['detail']}")
    else:
        print(f"Question: {question!r}")
        print("Result: PASSED")
        print()
        print("Answer:")
        print(result["answer"])


def cmd_gate_test(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    sc = load_sc(s)
    if sc is None:
        print("No sc capsule loaded — cannot run tests.")
        s.close()
        return

    print(f"Gate test: {sc.get('name')}")
    print(f"Rules: {[m['rule'] for m in sc.get('must', [])]}")
    print()

    passed, failed = 0, 0
    for tc in sc.get("test_cases", []):
        inp = tc["input"]
        expect_pass = tc["expect_pass"]
        reason = tc.get("reason", "")

        result = ask_gated(s, inp, sc=sc)
        if result.get("no_intent"):
            actual_pass = None  # can't say
        elif result.get("rejected"):
            actual_pass = False
        else:
            actual_pass = True

        if actual_pass == expect_pass:
            status = "OK"
            passed += 1
        else:
            status = "FAIL"
            failed += 1

        print(f"  [{status}] input: {inp!r}")
        print(f"         expected: {'pass' if expect_pass else 'reject'}, got: {'pass' if actual_pass else 'reject' if actual_pass is False else 'no-intent'}")
        if reason:
            print(f"         reason: {reason}")
        if actual_pass is False and result.get("check"):
            for v in result["check"]["violations"]:
                print(f"         violation: [{v['rule']}] {v['detail']}")
        print()

    s.close()
    print(f"{passed} passed, {failed} failed")
    return 0 if failed == 0 else 1


def cmd_cube_new(args):
    from kg_agent import create_cube
    s = Substrate()
    tags = args.tag or None
    result = create_cube(s, args.content, source=args.source, tags=tags)
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    print(f"Created: {result['cube_id']}")
    print(f"  content: {args.content!r}")
    if args.source:
        print(f"  source: {args.source}")
    print()
    print("Empty cube. Fill lenses with: kg cube fill <id> <lens> \"<content>\"")
    print(f"Lenses: {', '.join(__import__('kg_agent').LENSES)}")


def cmd_cube_fill(args):
    from kg_agent import fill_face, LENSES
    lens = args.lens.upper()
    if lens not in LENSES:
        print(f"error: invalid lens {lens!r}; must be one of {LENSES}")
        return
    s = Substrate()
    result = fill_face(s, args.cube_id, lens, args.content,
                       confidence=args.confidence, filled_by="human")
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    print(f"Filled: {result['face_id']}")
    print(f"  {lens}: {args.content!r}")


def cmd_cube_validate(args):
    from kg_agent import validate
    s = Substrate()
    result = validate(s, args.cube_id, args.by, note=args.note)
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    print(f"Validated: {args.cube_id}")
    print(f"  validator: {args.by}")
    if args.note:
        print(f"  note: {args.note}")


def cmd_cube_show(args):
    from kg_agent import show_cube, LENSES
    s = Substrate()
    data = show_cube(s, args.cube_id)
    s.close()
    if "error" in data:
        print(f"error: {data['error']}")
        return

    print(f"{data['cube_id']}")
    print(f"  content: {data['content']!r}")
    if data.get("source"):
        print(f"  source: {data['source']}")
    if data.get("tags"):
        print(f"  tags: {data['tags']}")
    print(f"  created: {data['created_at']}")
    if data.get("contradicts"):
        print(f"  contradicts: {data['contradicts']['other']} ({data['contradicts'].get('note') or 'no note'})")
    print()

    print("  Faces:")
    for lens in LENSES:
        face = data["faces"].get(lens)
        if face:
            c = face.get("content", "")
            if len(c) > 60:
                c = c[:57] + "..."
            print(f"    [x] {lens:10} {c}")
        else:
            print(f"    [ ] {lens:10} (empty)")
    print()

    v = data.get("validation")
    if v:
        note = v.get("note") or ""
        if len(note) > 60:
            note = note[:57] + "..."
        print(f"  Validated by {v.get('validator')} at {v.get('validated_at')}")
        if note:
            print(f"    note: {note}")
    else:
        print("  Validation: (not yet validated)")
    print()

    comp = data["completeness"]
    print(f"  Completeness: {comp['score']:.2f} ({len(comp['filled_lenses'])}/5 lenses"
          f"{' + validated' if comp['validated'] else ''})")
    if comp["missing_lenses"]:
        print(f"  Missing lenses: {', '.join(comp['missing_lenses'])}")
    print(f"  Attestation eligible: {'YES' if comp['complete'] else 'NO'}")


def cmd_cube_list(args):
    from kg_agent import list_cubes
    s = Substrate()
    cubes = list_cubes(s)
    s.close()
    if not cubes:
        print("No cubes yet.")
        return
    for c in cubes:
        marker = "[complete]" if c["complete"] else "[incomplete]"
        print(f"  {c['id']:45} {c['score']:.2f} {marker}")


def cmd_cube_contradicts(args):
    from kg_agent import set_contradicts
    s = Substrate()
    result = set_contradicts(s, args.cube_id, args.other_id, note=args.note)
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    print(f"{result['cube_id']} contradicts {result['contradicts']}")


def cmd_neighbour_link(args):
    from kg_agent import link_neighbour
    s = Substrate()
    result = link_neighbour(s, args.cube_a, args.cube_b, note=args.note)
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    print(f"Linked: {result['cube_a']} <-> {result['cube_b']}")
    if args.note:
        print(f"  note: {args.note}")


def cmd_neighbour_list(args):
    from kg_agent import list_neighbours
    s = Substrate()
    result = list_neighbours(s, args.cube_id)
    s.close()
    if "error" in result:
        print(f"error: {result['error']}")
        return
    if not result["neighbours"]:
        print(f"{result['cube']} has no neighbours.")
    else:
        print(f"{result['cube']} neighbours:")
        for n in result["neighbours"]:
            print(f"  -> {n}")


def main():
    ap = argparse.ArgumentParser(prog="kg", description="Keystone Gate CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("stats", help="count Keystone Gate capsules in substrate")
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("route", help="neighbourhood-router operations")
    sp_sub = sp.add_subparsers(dest="route_cmd", required=True)
    sp_list = sp_sub.add_parser("list", help="list all neighbours")
    sp_list.set_defaults(func=cmd_route_list)

    sp = sub.add_parser("ask", help="ask the substrate, gated — refuses if compliance fails")
    sp.add_argument("question", nargs="+")
    sp.set_defaults(func=cmd_ask)

    sp = sub.add_parser("gate", help="gate operations")
    sp_sub = sp.add_subparsers(dest="gate_cmd", required=True)

    sp_check = sp_sub.add_parser("check", help="check whether an answer passes the gate")
    sp_check.add_argument("question", nargs="+")
    sp_check.set_defaults(func=cmd_gate_check)

    sp_test = sp_sub.add_parser("test", help="run the sc capsule's test cases")
    sp_test.set_defaults(func=cmd_gate_test)

    sp = sub.add_parser("cube", help="cube operations")
    sp_sub = sp.add_subparsers(dest="cube_cmd", required=True)

    sp_new = sp_sub.add_parser("new", help="create a new cube")
    sp_new.add_argument("content")
    sp_new.add_argument("--source", default=None)
    sp_new.add_argument("--tag", action="append", default=None)
    sp_new.set_defaults(func=cmd_cube_new)

    sp_fill = sp_sub.add_parser("fill", help="fill one lens face")
    sp_fill.add_argument("cube_id")
    sp_fill.add_argument("lens")
    sp_fill.add_argument("content")
    sp_fill.add_argument("--confidence", type=float, default=None)
    sp_fill.set_defaults(func=cmd_cube_fill)

    sp_val = sp_sub.add_parser("validate", help="record human validation")
    sp_val.add_argument("cube_id")
    sp_val.add_argument("--by", required=True)
    sp_val.add_argument("--note", default=None)
    sp_val.set_defaults(func=cmd_cube_validate)

    sp_show = sp_sub.add_parser("show", help="show cube state")
    sp_show.add_argument("cube_id")
    sp_show.set_defaults(func=cmd_cube_show)

    sp_list = sp_sub.add_parser("list", help="list all cubes")
    sp_list.set_defaults(func=cmd_cube_list)

    sp_con = sp_sub.add_parser("contradicts", help="flag cube as contradicting another")
    sp_con.add_argument("cube_id")
    sp_con.add_argument("other_id")
    sp_con.add_argument("--note", default=None)
    sp_con.set_defaults(func=cmd_cube_contradicts)

    sp = sub.add_parser("neighbour", help="neighbour operations")
    sp_sub = sp.add_subparsers(dest="neighbour_cmd", required=True)

    sp_n_link = sp_sub.add_parser("link", help="link two cubes as neighbours")
    sp_n_link.add_argument("cube_a")
    sp_n_link.add_argument("cube_b")
    sp_n_link.add_argument("--note", default=None)
    sp_n_link.set_defaults(func=cmd_neighbour_link)

    sp_n_list = sp_sub.add_parser("list", help="list neighbours of a cube")
    sp_n_list.add_argument("cube_id")
    sp_n_list.set_defaults(func=cmd_neighbour_list)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
