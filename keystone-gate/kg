#!/usr/bin/env python3
"""kg — Keystone Gate CLI. Shares substrate DB with scps."""
import argparse
import sys
from pathlib import Path

# Two paths:
#   parent.parent/src → find `substrate`
#   parent        → find `kg_*` siblings
_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here.parent / "src"))
sys.path.insert(0, str(_here))

from substrate import Substrate
from kg_cube_cli import *
from kg_subject_cli import add_subject_parser
from kg_entity_cli import add_entity_parser


def cmd_stats(args):
    from kg_stats import stats
    st = stats()
    print("Keystone Gate content in substrate:")
    for k, v in st.items():
        print(f"  {k:12} {v}")


def cmd_route_list(args):
    from kg_router import route_list
    rows = route_list()
    if not rows:
        print("No neighbours yet.")
        print("Cubes have no neighbour links.")
        return
    for r in rows:
        print(f"  {r['cube']}")
        for n in r["neighbours"]:
            print(f"    -> {n}")


def cmd_ask(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    question = " ".join(args.question)
    if args.claude:
        from kg_llm import ask_llm
        result = ask_llm(s, question)
    else:
        result = ask_gated(s, question, sc=load_sc(s))
    s.close()

    if result.get("tried"):
        print(f"(Worded by {result['source']}. Passed over: {'; '.join(result['tried'])})")
        print()

    if result.get("fallback_reason"):
        print(f"(No model used: {result['fallback_reason']}. Showing the walker's answer.)")
        for v in result.get("refused", {}).get("violations", []):
            print(f"  - {v['rule']}: {v['detail']}")
        print()

    if result.get("no_intent"):
        print(f"No intent matched for: {question!r}")
        print("(nothing to gate, nothing to answer)")
        return

    if result.get("rejected"):
        print(f"Gate rejected the answer.")
        for v in result["check"]["violations"]:
            print(f"  - {v['rule']}: {v['detail']}")
        print()
        print("The answer is withheld. Compliance must pass before any answer is shown.")
        return

    print(result["answer"])


def cmd_gate_check(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    question = " ".join(args.question)
    sc = load_sc(s)
    if sc is None:
        print("No sc capsule loaded — cannot gate.")
        s.close()
        return
    print(f"Gate: {sc.get('name')}")
    print(f"Rules: {[m['rule'] for m in sc.get('must', [])]}")
    print()

    result = ask_gated(s, question, sc=sc)
    s.close()

    if result.get("no_intent"):
        print(f"Question: {question!r}")
        print("Result: no intent matched — nothing to check")
        return

    if result.get("rejected"):
        print(f"Question: {question!r}")
        print("Result: REJECTED")
        for v in result["check"]["violations"]:
            print(f"  violation [{v['rule']}]: {v['detail']}")
    else:
        print(f"Question: {question!r}")
        print("Result: PASSED")
        print()
        print("Answer:")
        print(result["answer"])


def cmd_gate_test(args):
    from kg_hal import ask_gated
    from kg_gate import load_sc
    s = Substrate()
    sc = load_sc(s)
    if sc is None:
        print("No sc capsule loaded — cannot run tests.")
        s.close()
        return

    print(f"Gate test: {sc.get('name')}")
    print(f"Rules: {[m['rule'] for m in sc.get('must', [])]}")
    print()

    passed, failed = 0, 0
    for tc in sc.get("test_cases", []):
        inp = tc["input"]
        expect_pass = tc["expect_pass"]
        reason = tc.get("reason", "")

        result = ask_gated(s, inp, sc=sc)
        if result.get("no_intent"):
            actual_pass = None  # can't say
        elif result.get("rejected"):
            actual_pass = False
        else:
            actual_pass = True

        if actual_pass == expect_pass:
            status = "OK"
            passed += 1
        else:
            status = "FAIL"
            failed += 1

        print(f"  [{status}] input: {inp!r}")
        print(f"         expected: {'pass' if expect_pass else 'reject'}, got: {'pass' if actual_pass else 'reject' if actual_pass is False else 'no-intent'}")
        if reason:
            print(f"         reason: {reason}")
        if actual_pass is False and result.get("check"):
            for v in result["check"]["violations"]:
                print(f"         violation: [{v['rule']}] {v['detail']}")
        print()

    s.close()
    print(f"{passed} passed, {failed} failed")
    return 0 if failed == 0 else 1


def main():
    ap = argparse.ArgumentParser(prog="kg", description="Keystone Gate CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("stats", help="count Keystone Gate capsules in substrate")
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("route", help="neighbourhood-router operations")
    sp_sub = sp.add_subparsers(dest="route_cmd", required=True)
    sp_list = sp_sub.add_parser("list", help="list all neighbours")
    sp_list.set_defaults(func=cmd_route_list)

    sp = sub.add_parser("overlaps", help="list overlapping work, valued by Leighton weight")
    sp.add_argument("--min", type=float, help="lowest λ to list (default 0.60)")
    sp.set_defaults(func=cmd_overlaps)

    sp = sub.add_parser("repo", help="repos as boxes of cubes")
    sp_sub = sp.add_subparsers(dest="repo_cmd", required=True)
    sp_add = sp_sub.add_parser("add", help="read each repo's README and write claim cubes; private repos stay local")
    sp_add.add_argument("repos", nargs="+", help="owner/name")
    sp_add.set_defaults(func=cmd_repo_add)

    sp = sub.add_parser("ask", help="ask the substrate, gated — refuses if compliance fails")
    sp.add_argument("question", nargs="+")
    sp.add_argument("--claude", action="store_true",
                    help="have a model reword the answer: Claude, then Gemini, then local Ollama")
    sp.set_defaults(func=cmd_ask)

    sp = sub.add_parser("gate", help="gate operations")
    sp_sub = sp.add_subparsers(dest="gate_cmd", required=True)

    sp_check = sp_sub.add_parser("check", help="check whether an answer passes the gate")
    sp_check.add_argument("question", nargs="+")
    sp_check.set_defaults(func=cmd_gate_check)

    sp_test = sp_sub.add_parser("test", help="run the sc capsule's test cases")
    sp_test.set_defaults(func=cmd_gate_test)

    sp = sub.add_parser("cube", help="cube operations")
    sp_sub = sp.add_subparsers(dest="cube_cmd", required=True)

    sp_new = sp_sub.add_parser("new", help="create a new cube")
    sp_new.add_argument("content")
    sp_new.add_argument("--source", default=None)
    sp_new.add_argument("--tag", action="append", default=None)
    sp_new.add_argument("--subject", action="append", default=None, help="subject/<slug> this claim is about")
    sp_new.add_argument("--entity", action="append", default=None, help="an entity this claim is about, such as james")
    sp_new.add_argument("--from", dest="evidence", action="append", default=None,
                        help="a capsule this claim is derived from, such as a document")
    sp_new.set_defaults(func=cmd_cube_new)

    sp_fill = sp_sub.add_parser("fill", help="fill one lens face")
    sp_fill.add_argument("cube_id")
    sp_fill.add_argument("lens")
    sp_fill.add_argument("content")
    sp_fill.add_argument("--confidence", type=float, default=None)
    sp_fill.set_defaults(func=cmd_cube_fill)

    sp_val = sp_sub.add_parser("validate", help="record human validation")
    sp_val.add_argument("cube_id")
    sp_val.add_argument("--by", required=True)
    sp_val.add_argument("--note", default=None)
    sp_val.set_defaults(func=cmd_cube_validate)

    sp_att = sp_sub.add_parser("attest", help="vouch for a complete cube; adds trust evidence")
    sp_att.add_argument("cube_id")
    sp_att.add_argument("--by", required=True)
    sp_att.add_argument("--note", default=None)
    sp_att.set_defaults(func=cmd_cube_attest)

    sp_rev = sp_sub.add_parser("review", help="walk through proposals, lenses, validation, attestation")
    sp_rev.add_argument("cube_id", nargs="?", default=None)
    sp_rev.add_argument("--by", required=True)
    sp_rev.add_argument("--tag", default=None, help="only cubes with this tag")
    sp_rev.set_defaults(func=cmd_cube_review)

    sp_draft = sp_sub.add_parser("draft", help="have a model draft blank faces, for you to confirm")
    sp_draft.add_argument("cube_id", nargs="?")
    sp_draft.set_defaults(func=cmd_cube_draft)

    sp_notes = sp_sub.add_parser("notes", help="suggest validation notes, for you to check and save")
    sp_notes.add_argument("cube_id", nargs="?")
    sp_notes.set_defaults(func=cmd_cube_notes)

    sp_pass = sp_sub.add_parser("password", help="set the password that unlocks editing in the browser")
    sp_pass.set_defaults(func=cmd_cube_password)

    sp_serve = sp_sub.add_parser("serve", help="work on cubes in the browser, on this machine only")
    sp_serve.add_argument("--by", required=True)
    sp_serve.add_argument("--port", type=int, default=8765)
    sp_serve.add_argument("--no-open", action="store_true")
    sp_serve.add_argument("--host", action="append", default=[],
                          help="another name this page answers to, such as a Tailscale address")
    sp_serve.set_defaults(func=cmd_cube_serve)

    sp_view = sp_sub.add_parser("view", help="see the cubes in your browser")
    sp_view.add_argument("--no-open", action="store_true", help="write the page only")
    sp_view.set_defaults(func=cmd_cube_view)

    sp_snap = sp_sub.add_parser("snapshot", help="write a read-only public copy, without private cubes or drafts")
    sp_snap.set_defaults(func=cmd_cube_snapshot)

    sp_show = sp_sub.add_parser("show", help="show cube state")
    sp_show.add_argument("cube_id")
    sp_show.set_defaults(func=cmd_cube_show)

    sp_list = sp_sub.add_parser("list", help="list all cubes")
    sp_list.set_defaults(func=cmd_cube_list)

    sp_con = sp_sub.add_parser("contradicts", help="flag cube as contradicting another")
    sp_con.add_argument("cube_id")
    sp_con.add_argument("other_id")
    sp_con.add_argument("--note", default=None)
    sp_con.set_defaults(func=cmd_cube_contradicts)

    sp_c_prop = sp_sub.add_parser("proposals", help="list proposals for a cube")
    sp_c_prop.add_argument("cube_id", nargs="?", default=None)
    sp_c_prop.add_argument("--status", default="pending",
                           choices=["pending", "accepted", "rejected", "any"])
    sp_c_prop.set_defaults(func=cmd_cube_proposals)

    sp_c_acc = sp_sub.add_parser("accept", help="accept a proposal")
    sp_c_acc.add_argument("proposal_id")
    sp_c_acc.add_argument("--by", required=True)
    sp_c_acc.add_argument("--word", help="connecting word for a link, such as protects or depends on")
    sp_c_acc.add_argument("--reverse", action="store_true", help="read the link from the other cube")
    sp_c_acc.set_defaults(func=cmd_cube_accept)

    sp_c_rej = sp_sub.add_parser("reject", help="reject a proposal")
    sp_c_rej.add_argument("proposal_id")
    sp_c_rej.add_argument("--by", required=True)
    sp_c_rej.add_argument("--reason", default=None)
    sp_c_rej.set_defaults(func=cmd_cube_reject)

    sp_c_tick = sp_sub.add_parser("tick", help="run rules against cubes")
    sp_c_tick.add_argument("cube_id", nargs="?", default=None)
    sp_c_tick.set_defaults(func=cmd_cube_tick)

    sp = sub.add_parser("neighbour", help="neighbour operations")
    sp_sub = sp.add_subparsers(dest="neighbour_cmd", required=True)

    sp_n_link = sp_sub.add_parser("link", help="link two cubes as neighbours")
    sp_n_link.add_argument("cube_a")
    sp_n_link.add_argument("cube_b")
    sp_n_link.add_argument("--note", default=None)
    sp_n_link.set_defaults(func=cmd_neighbour_link)

    sp_n_list = sp_sub.add_parser("list", help="list neighbours of a cube")
    sp_n_list.add_argument("cube_id")
    sp_n_list.set_defaults(func=cmd_neighbour_list)

    add_subject_parser(sub)
    add_entity_parser(sub)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
